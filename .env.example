# Career Launchpad Environment Configuration Template
# Copy this file to .env or .env.local for local development

# -------------------------------------------------------------
# Frontend Client Configuration (Vite)
# -------------------------------------------------------------
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# -------------------------------------------------------------
# Supabase Edge Functions Secrets (Set via: supabase secrets set)
# DO NOT EXPOSE IN FRONTEND CODE
# -------------------------------------------------------------
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-secret-key-here

# Resend API Credentials for Transactional Ticket Delivery
RESEND_API_KEY=re_your_resend_api_key_here

# Google Sheets API Integration
GOOGLE_SHEET_ID=your_google_spreadsheet_id_here
GOOGLE_SERVICE_ACCOUNT_EMAIL=career-launchpad-sync@your-project.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQC...\n-----END PRIVATE KEY-----\n"
